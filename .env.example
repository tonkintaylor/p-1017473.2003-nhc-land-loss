# Copy to .env and fill in. The .env file is gitignored.
TNT_KOORDINATES_API_KEY=
KOORDINATES_PUBLIC_API_KEY=
LINZ_API_KEY=
LRIS_API_KEY=

# Where downloads are cached. Leave it unset: it defaults to .koopcache at the
# repo root, which is gitignored. Set it only to put the cache on another disk,
# and use an absolute path when you do -- a relative value is anchored to the
# repo root regardless, so it cannot name anywhere else.
# KOOPCACHE_DIR=

# tdrive_sync -- see README.md "Environment variables" for the full local-mode
# fallback chain.
TTDRIVE_SYNC_LOCAL_MODE=False
TTDRIVE_SYNC_LOCAL_VERSION=
TTDRIVE_SYNC_CACHE_DIR=.tdrivecache
